Authmeddleware.js
const jwt = require("jsonwebtoken");

module.exports = (req,res,next)=>{
const token = req.headers.authorization;

if(!token) return res.json("Access Denied");

try{
const verified = jwt.verify(token,"secretkey");
req.user = verified;
next();
}catch{
res.json("Invalid Token");
}
}
